# Database and authentication
SKINVISION_DB_URL=sqlite:///./data/skinvision.db
SKINVISION_ENABLE_AUTH=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SKINVISION_AUTH_SECRET=

# LMDAUNet segmentation. Set to a downloaded or trained checkpoint.
SKINVISION_WEIGHTS=
SKINVISION_NORMALIZATION=train_minmax_255
# 1 forces CPU; 0 allows CUDA when available.
SKINVISION_CPU=0

# Public EfficientNet-B0 for classification. Run the classifier downloader first.
SKINVISION_CLASSIFICATION_BACKEND=local
SKINVISION_CLASSIFICATION_DIR=./weights/classification/efficientnet-b0-research
SKINVISION_CLASSIFICATION_DEVICE=cpu
# Optional multimodal API. Set classification backend to api for API classification.
DASHSCOPE_API_KEY=
SKINVISION_CLASSIFICATION_MODEL=qwen3-vl-plus
SKINVISION_LLM_MODEL=qwen3-vl-plus
SKINVISION_LLM_TIMEOUT=60

# Storage and PDF export. When upgrading, keep the original artifact directory.
SKINVISION_TEMP_DIR=./outputs/service
SKINVISION_PDF_ENGINE=reportlab
SKINVISION_PDF_FONT=
